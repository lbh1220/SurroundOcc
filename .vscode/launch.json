            "args": [
                "--input",
                "data/nuscenes_infos_val.pkl",
                "--output",
                "data/nuscenes_infos_val_mini.pkl",
                "--num_samples",
                "1"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "python": "/home/liang/anaconda3/envs/surroundocc/bin/python",
